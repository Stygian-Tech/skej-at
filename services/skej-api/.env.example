APP_ENV=local
PORT=8080

# Public origin for this gateway's OAuth metadata. ATProto providers fetch
# SKEJ_PUBLIC_ORIGIN/oauth/client-metadata.json and use it as the client_id.
# Local API example: http://127.0.0.1:8080.
# Hosted dev: use the public API origin, for example https://api.testing.skej.at.
SKEJ_PUBLIC_ORIGIN=http://127.0.0.1:8080

# Browser-facing app origin for OAuth redirects after authorization.
# Leave empty when it is the same as SKEJ_PUBLIC_ORIGIN.
# Local web example: http://127.0.0.1:3000.
# Hosted dev example: https://testing.skej.at.
SKEJ_WEB_ORIGIN=http://127.0.0.1:3000

SKEJ_SQLITE_PATH=data/skej.sqlite
SKEJ_WORKER_ENABLED=true
SKEJ_WORKER_INTERVAL_SECONDS=30
SKEJ_LIVE_ATPROTO_ENABLED=false
SKEJ_PRO_ENABLED=true
SKEJ_ADMIN_DIDS=
SKEJ_ENGAGEMENT_ENABLED=true
SKEJ_ENGAGEMENT_INTERVAL_SECONDS=900
SKEJ_BSKY_APPVIEW_ORIGIN=https://public.api.bsky.app

# Account-bound service authentication uses this HTTPS API origin for its DID.
# Hosted defaults are https://api.testing.skej.at or https://api.skej.at.
# This is independent of the existing OAuth metadata SKEJ_PUBLIC_ORIGIN.
# SKEJ_API_ORIGIN=https://api.testing.skej.at
# Exact DID-web issuer origins; PLC accounts do not require this allowlist.
# SKEJ_DID_WEB_ORIGINS=https://issuer.example
# Additional exact HTTPS browser origins (hosted Skej/Social Wire origins are defaults).
# SKEJ_CORS_ORIGINS=https://client.example
# APP_ENV=local only: configure an isolated HTTPS ATProto sandbox, preserving CA trust.
# SKEJ_LOCAL_PLC_ORIGIN=https://plc.atmosbox.test
# SKEJ_LOCAL_HANDLE_RESOLVER_ORIGIN=https://appview.atmosbox.test
# SKEJ_LOCAL_PDS_ORIGINS=https://pds1.atmosbox.test,https://pds2.atmosbox.test
# SKEJ_LOCAL_DID_WEB_ORIGINS=https://issuer.atmosbox.test
